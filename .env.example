# Local `npm start` uses PORT, HOST, DATA_DIR and STATIC_DIR; the Docker image sets its own.
PORT=8787
DATA_DIR=.data
STATIC_DIR=dist

# Exact public HTTPS origin, no path or trailing slash, e.g. https://greed.example.com
PUBLIC_ORIGIN=
# Exact IP of the reverse proxy as the app sees it (e.g. a cloudflared container's fixed
# address on the shared network). Blank: forwarded addresses are never trusted.
TRUSTED_PROXY=
# Header the trusted proxy uses for the visitor's address. Cloudflare: cf-connecting-ip.
# Blank: use the last X-Forwarded-For entry from the trusted proxy.
CLIENT_IP_HEADER=
# Docker Compose only: the existing external network shared with the proxy.
PROXY_NETWORK=edge
